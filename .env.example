# Copy this file to .env and fill in your values

# Database (PostgreSQL — see README/DEPLOYMENT for local install or a free hosted option like Neon/Supabase/Railway)

# Gmail sending (use an App Password, not your normal Gmail password:
# https://myaccount.google.com/apppasswords — requires 2FA enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Same Gmail account is reused for IMAP reply polling
IMAP_HOST=imap.gmail.com

# Public URL where FastAPI is reachable (needed so tracking pixel/click
# links work when emails are opened elsewhere). Use ngrok or similar
# while testing locally, e.g. https://abcd1234.ngrok.io
PUBLIC_BASE_URL=http://localhost:8000

# Groq API key for reply sentiment classification (free tier available)
GROQ_API_KEY=your_groq_api_key
DATABASE_URL=postgresql://neondb_owner:npg_nLeY5o9iAdqR@ep-divine-hat-ayrkzh7s-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
